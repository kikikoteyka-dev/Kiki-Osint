# VK API Token
# Получить: https://vkhost.github.io/ — выбери "Kate Mobile", нажми "Разрешить"
# Из адресной строки скопируй значение access_token=...
VK_TOKEN=your_vk_token_here

# Telegram API credentials
# Получить: https://my.telegram.org → "API development tools"
TG_API_ID=12345678
TG_API_HASH=your_telegram_api_hash_here

# Google Gemini API Key (опционально, для AI-портрета)
# Получить бесплатно: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
